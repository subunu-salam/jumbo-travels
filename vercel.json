{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__path=$1" },
    { "source": "/packages/:slug", "destination": "/package.html" },
    { "source": "/admin", "destination": "/admin/index.html" }
  ],
  "functions": { "api/index.js": { "includeFiles": "data/seed.json" } },
  "headers": [
    { "source": "/(img|fonts)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/admin/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
